# Copy to .env.local and fill in.

# Repo whose stars grow the tree (defaults to bowwowxx/tree).
# GITHUB_REPO=bowwowxx/tree

# Permanent owner house (defaults to the owner of GITHUB_REPO).
# GITHUB_USER=bowwowxx

# Owner house appearance: cottage (default) or fisherman (village market model).
# OWNER_HOUSE_STYLE=fisherman

# The workshop cat always lives on the permanent owner house.
# No separate location setting is needed.

# A repository owner/admin or collaborator token authorized for GITHUB_REPO
# is needed to read stargazer names under GitHub's 2026 access restrictions.
# Read server-side only — never exposed to the browser.
# GITHUB_TOKEN=ghp_xxx

# Fallback star count shown when the repo doesn't exist yet / API fails.
# DEMO_STARS=8

# Show the in-scene +/- star editor (dev/preview only). Leave unset in
# production so visitors only ever see the real GitHub star count.
# NEXT_PUBLIC_DEV_CONTROLS=true
